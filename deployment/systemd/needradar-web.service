[Unit]
Description=NeedRadar Next.js
Wants=network-online.target
After=network-online.target needradar-api.service
Requires=needradar-api.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=needradar
Group=needradar
WorkingDirectory=/opt/needradar/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=API_INTERNAL_ORIGIN=http://127.0.0.1:8000
# Invoke Next directly, so npm is not an additional process parent.
ExecStart=/usr/bin/node /opt/needradar/frontend/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
# npm and Next.js descendants are terminated together on stop/restart.
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
